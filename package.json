{
  "name": "dsh-ppt",
  "version": "0.8.0",
  "description": "DSH 演示文稿插件：生成 HTML、可编辑 PPTX 和工程文件，支持图表、轻量编辑、撤销与质量检查。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skills/*": "./skills/*",
    "./deck-core": "./skills/dsh-ppt/scripts/deck-core.mjs",
    "./deck-advanced": "./skills/dsh-ppt/scripts/deck-advanced.mjs",
    "./deck-render": "./skills/dsh-ppt/scripts/deck-render.mjs",
    "./client": "./lib/client.js",
    "./build-deck": "./skills/dsh-ppt/scripts/build-deck.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "test:core": "node --test \"test/*.test.mjs\"",
    "smoke:cli": "node skills/dsh-ppt/scripts/build-deck.mjs --title \"DSH PPT Smoke\" --content @smoke/sample-deck.md --theme data --lang zh --out .smoke-deck"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "skills",
    "ppt",
    "pptx",
    "presentation",
    "slides",
    "html"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-ppt.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-ppt/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-ppt#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@office-kit/pptx": "0.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/libreoffice-kit": "0.1.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/libreoffice-kit": {
      "optional": true
    }
  }
}
