{
  "name": "dsh-ppt",
  "version": "0.34.0",
  "description": "DeepSeek Harness 大师级演示文稿引擎与工作台：支持企业品牌宪章锁与 SLOP-14 合规门禁、多源资料包融合直吞（.pdf/.docx/.xlsx/.png + 证据溯源）、多受众一键压缩改编与 4:5/1:1 社媒长图、HTML 现场演示增强包（⌘K 速搜/白板画笔/Q&A 倒计时/字幕导览）、20 套标杆范本、24 主题 / 37+ 原生可编辑图谱（点阵地图/2.5D 等轴测/Mermaid/公式/代码），导出离线 HTML + 100% 可编辑 PPTX。欢迎 PR 与 Issues。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skills/*": "./skills/*",
    "./deck-core": "./skills/dsh-ppt/scripts/deck-core.mjs",
    "./deck-advanced": "./skills/dsh-ppt/scripts/deck-advanced.mjs",
    "./deck-render": "./skills/dsh-ppt/scripts/deck-render.mjs",
    "./client": "./lib/client.js",
    "./build-deck": "./skills/dsh-ppt/scripts/build-deck.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/plugin-icon.webp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:core": "node --test \"test/*.test.mjs\"",
    "smoke:cli": "node skills/dsh-ppt/scripts/build-deck.mjs --title \"DSH PPT Smoke\" --content @smoke/sample-deck.md --theme data --lang zh --out .smoke-deck"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "skills",
    "ppt",
    "pptx",
    "presentation",
    "slides",
    "html",
    "deepseek",
    "ai-agent",
    "pptx-generator",
    "演示文稿",
    "幻灯片"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-ppt.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-ppt/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-ppt#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@office-kit/pptx": "0.21.0",
    "csv-parse": "6.1.0",
    "fflate": "0.8.3",
    "jsep": "1.4.0",
    "@stardustlc/dsh-updates": "0.2.10"
  },
  "peerDependencies": {
    "@deepseek-ai/libreoffice-kit": "0.1.5 || 0.2.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/libreoffice-kit": {
      "optional": true
    }
  },
  "icon": "./assets/plugin-icon.webp"
}
